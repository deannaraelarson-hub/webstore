{
  "version": 2,
  "builds": [
    { "src": "public/*.html", "use": "@vercel/static" }
  ],
  "functions": {
    "src/api/*.js": {
      "runtime": "nodejs18.x"
    }
  },
  "routes": [
    { "src": "/api/(.*)$", "dest": "/src/api/$1" },
    { "src": "/(.*)", "dest": "/public/$1" }
  ]
}
