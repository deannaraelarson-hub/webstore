{
  "version": 2,
  "builds": [
    { "src": "package.json", "use": "@vercel/node" }
  ],
  "functions": {
    "src/api/*.js": { "runtime": "nodejs18.x" }
  },
  "rewrites": [
    { 
      "source": "/api/(.*)", 
      "destination": "/src/api/$1.js" 
    },
    { 
      "source": "/(.*)", 
      "destination": "/public/$1" 
    }
  ]
}
